<!--
  USB DAC bit-perfect toggle icon (active state).

  Design: a 5-bar audio waveform (symmetric, center peak) — a clean,
  universally recognizable symbol for audio output. Tinted with
  colorPrimary to indicate the bit-perfect audio path is engaged.

  Replaces the prior potrace-traced design (37KB pathData) which
  exceeded AAPT2's ~32KB string limit and was silently replaced with
  "STRING_TOO_LARGE", causing a crash at toolbar inflation time.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="?attr/colorPrimary">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M190,340 h100 v280 h-100 z M310,220 h100 v520 h-100 z M430,160 h100 v640 h-100 z M550,220 h100 v520 h-100 z M670,340 h100 v280 h-100 z" />
</vector>
